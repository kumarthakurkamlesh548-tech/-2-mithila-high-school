rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        getUserData().role == 'SUPER_ADMIN' ||
        request.auth.token.email.toLowerCase() == 'kumarthakurkamlesh266@gmail.com' ||
        request.auth.token.email.toLowerCase() == 'kumarthakurkamlesh548@gmail.com' ||
        request.auth.token.email.toLowerCase() == 'superadmin@mithilahs.edu.in'
      );
    }

    function isAdmin() {
      return isAuthenticated() && (getUserData().role == 'ADMIN' || isSuperAdmin());
    }

    function isTeacher() {
      return isAuthenticated() && (getUserData().role == 'TEACHER' || isAdmin());
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (isSuperAdmin() || request.auth.uid == userId);
      allow update: if isAuthenticated() && (isSuperAdmin() || request.auth.uid == userId);
      allow delete: if isSuperAdmin();
    }

    // Role specific collections
    match /students/{studentId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /teachers/{teacherId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /admins/{adminId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // Academic & School Content
    match /notices/{id} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /results/{id} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /homework/{id} {
      allow read: if isAuthenticated();
      allow write: if isTeacher();
    }

    match /study_materials/{id} {
      allow read: if isAuthenticated();
      allow write: if isTeacher();
    }

    match /attendance/{id} {
      allow read: if isAuthenticated();
      allow write: if isTeacher();
    }

    match /timetables/{id} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /doubts/{id} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isTeacher();
    }

    match /events/{id} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /gallery/{id} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /downloads/{id} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /syllabus/{id} {
      allow read: if isAuthenticated();
      allow write: if isTeacher();
    }

    match /subjects/{id} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /classes/{id} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /sections/{id} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /permissions/{id} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /academic_sessions/{id} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /{document=**} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }
  }
}
