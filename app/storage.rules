rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // Allow public read for PDFs, images, and documents
      allow read: if true;
      // Allow authenticated users (Admins, Teachers, Super Admins) to upload files
      allow write: if request.auth != null;
    }
  }
}
